{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@{{ opencode_slim_version }}/oh-my-opencode-slim.schema.json",

  // OpenCode v2 renders subagents natively; terminal multiplexers stay disabled.
  "preset": "openai",
  "autoUpdate": false,
  "multiplexer": { "type": "none" },

  // Omitting "mcps" keeps slim's per-agent defaults (explorer: context7, gh_grep).
  "presets": {
    "openai": {
      "orchestrator": {
        "model": "{{ opencode_default_model }}",
        "variant": "medium",
        "skills": ["*"]
      },
      "oracle": {
        "model": "{{ opencode_default_model }}",
        "variant": "high",
        "skills": ["simplify"]
      },
      "explorer": {
        "model": "{{ opencode_small_model }}",
        "variant": "low",
        "skills": []
      },
      "designer": {
        "model": "{{ opencode_small_model }}",
        "variant": "medium",
        "skills": []
      },
      "fixer": {
        "model": "{{ opencode_default_model }}",
        "variant": "low",
        "skills": []
      }
    }
  }
}
