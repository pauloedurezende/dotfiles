{
  "$schema": "https://opencode.ai/v2/cli.json",
  "prompt": {
    // Render large pasted content in full instead of collapsing it in the composer.
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "thinking": "hide",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "indicators": "status"
  },
  "diffs": {
    "source": "branch",
    "wrap": "word",
    "tree": true,
    "view": "auto"
  }
}
