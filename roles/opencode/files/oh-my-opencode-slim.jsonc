      },
      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": ["codegraph"]
      },
      "designer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "xhigh",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "openai/gpt-5.6-luna",
