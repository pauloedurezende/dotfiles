{
  "$schema": "https://opencode.ai/config.json",

  // ── Models ───────────────────────────────────────────
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",

  // ── Plugins ──────────────────────────────────────────
  "plugin": [
    "oh-my-opencode-slim",
    "@mohak34/opencode-notifier"
  ],

  // ── Global behavior ──────────────────────────────────
  // OpenCode is installed through Homebrew, so only notify about updates.
  "autoupdate": "notify",
  "logLevel": "INFO",
  "share": "manual",
  "snapshot": true,

  // ── Output and context ───────────────────────────────
  "tool_output": {
    "max_bytes": 51200,
    "max_lines": 2000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 15
  },

  // oh-my-opencode-slim provides its own orchestrator and specialist agents.
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },

  // OpenCode is permissive by default. Only exceptions belong here.
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      ".aws/credentials": "deny",
      "**/.aws/credentials": "deny",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.netrc": "deny"
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      ".aws/credentials": "deny",
      "**/.aws/credentials": "deny",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      ".git/**": "deny",
      "**/.git/**": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.netrc": "deny"
    },
    "bash": {
      // Bash can bypass read/edit rules, so block direct access to secrets too.
      "*.env*": "deny",
      "*secrets/*": "deny",
      "*.aws/credentials*": "deny",
      "*.ssh/*": "deny",
      "*.npmrc*": "deny",
      "*.pypirc*": "deny",
      "*.netrc*": "deny",

      // Ask only before external side effects; deny destructive operations.
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git clean -*f*": "deny",
      "git checkout -- *": "deny",
      "git restore*": "deny",
      "git push -f*": "deny",
      "git push --force*": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",

      // RTK rewrites commands before OpenCode evaluates permissions.
      "rtk git push*": "ask",
      "rtk git reset --hard*": "deny",
      "rtk git clean -*f*": "deny",
      "rtk git checkout -- *": "deny",
      "rtk git restore*": "deny",
      "rtk git push -f*": "deny",
      "rtk git push --force*": "deny",
      "rtk proxy sudo *": "deny",
      "rtk proxy rm -rf *": "deny",
      "rtk proxy rm -fr *": "deny"
    },
    "external_directory": {
      "*": "ask",
      // OpenCode's macOS scratch directory varies between user temp roots.
      "/var/folders/**/T/opencode": "allow",
      "/var/folders/**/T/opencode/**": "allow"
    },
    "doom_loop": "deny"
  },

  // ── Language Server Protocol ─────────────────────────
  "lsp": true,

  // ── MCP servers ──────────────────────────────────────
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
