{
  "$schema": "https://opencode.ai/config.json",

  // ── Models ───────────────────────────────────────────
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",

  // ── Plugins ──────────────────────────────────────────
  // Pin the version to keep the workflow reproducible.
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v5.0.6"
  ],

  // ── Global behavior ──────────────────────────────────
  // If installed through Homebrew, set this to false and update with brew.
  "autoupdate": "notify",
  "logLevel": "INFO",
  "share": "manual",
  "snapshot": true,

  // ── Output and context ───────────────────────────────
  "tool_output": {
    "max_bytes": 32768,
    "max_lines": 1000
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6,
    "preserve_recent_tokens": 60000,
    "reserved": 20000
  },

  // ── File watcher ─────────────────────────────────────
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".next/**",
      ".turbo/**"
    ]
  },

  // ── Global permissions ───────────────────────────────
  "permission": {
    // Require approval for any new or unspecified tool.
    "*": "ask",

    "read": {
      "*": "allow",

      // Environment files may contain credentials.
      "*.env": "deny",
      "*.env.*": "deny",

      // Sanitized environment templates are safe to read.
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",

      // Sensitive directories.
      "secrets/**": "deny",
      "**/secrets/**": "deny",

      ".aws/**": "deny",
      "**/.aws/**": "deny",

      ".ssh/**": "deny",
      "**/.ssh/**": "deny",

      ".gnupg/**": "deny",
      "**/.gnupg/**": "deny",

      // Common credential files.
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.netrc": "deny",

      // These files may be legitimate project assets.
      "*.pem": "ask",
      "*.key": "ask"
    },

    "edit": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",

      "secrets/**": "deny",
      "**/secrets/**": "deny",

      ".aws/**": "deny",
      "**/.aws/**": "deny",

      ".ssh/**": "deny",
      "**/.ssh/**": "deny",

      ".gnupg/**": "deny",
      "**/.gnupg/**": "deny",

      // Prevent direct modification of Git metadata.
      ".git/**": "deny",
      "**/.git/**": "deny",

      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.netrc": "deny"
    },

    // Glob and grep permissions match their search expressions,
    // not the filesystem paths they eventually inspect.
    "glob": "allow",
    "grep": "allow",
    "list": "allow",

    "question": "allow",
    "todowrite": "allow",
    "lsp": "allow",

    // Allow Superpowers to load skills and delegate tasks.
    "skill": "allow",
    "task": "allow",

    "websearch": "allow",
    "webfetch": "allow",

    // Allow native Plan/Build transitions as a fallback.
    "plan_enter": "allow",
    "plan_exit": "allow",

    // Require approval for filesystem access outside the project.
    "external_directory": "ask",
    "doom_loop": "ask",

    "bash": {
      // Require approval for commands not explicitly allowed below.
      "*": "ask",

      // Frequently used low-risk commands.
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git branch --show-current*": "allow",

      // Explicit denials remain active when auto-approval is enabled.
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push -f*": "deny",
      "git push --force*": "deny"
    }
  },

  // ── Language Server Protocol ─────────────────────────
  "lsp": true,

  // ── MCP servers ──────────────────────────────────────
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "timeout": 10000
    },

    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
